# Twelve Data API Key (Optional but recommended for real-time data)
# Get a free key at: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Backend Cache TTL in seconds (default 60 seconds)
CACHE_TTL=60

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://stock-prize-pridiction.vercel.app